// -*- mode: jsonc -*-
{
  "height": 30,
  "spacing": 6,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "tray",
    "clock"
  ],

  /* ---------------- Hyprland ---------------- */

  "hyprland/workspaces": {
    "format": "{windows}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true,
    "on-click": "activate",

    "window-rewrite": {
      "class<firefox>": "",
      "class<kitty>": "",
      "code": "󰨞",
      "Code": "󰨞",
      "class<org.kde.dolphin>": "",
      "class<mpv>": "",
      "class<discord>": "󰙯",
      "class<steam>": "",
      ".*": ""
    }
  },

  /* ---------------- Audio ---------------- */

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": " muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  /* ---------------- Network ---------------- */

  "network": {
    "format-wifi": "{essid} {signalStrength}% ",
    "format-ethernet": "{ipaddr} 󰈀",
    "format-disconnected": "No net ⚠",
    "tooltip": true
  },

  /* ---------------- Tray ---------------- */

  "tray": {
    "spacing": 8
  },

  /* ---------------- Clock ---------------- */

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<small>{calendar}</small>"
  }
}
